# Copy this file to ".env" and fill in the real values.
# The real .env is gitignored and must NEVER be committed.

# Signs the login session cookies. Any long random string.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace-with-a-long-random-string

# The Gmail account that sends reminder emails.
EMAIL_ADDRESS=you@gmail.com

# A Gmail APP PASSWORD, not your normal password.
# Google account -> Security -> 2-Step Verification -> App passwords.
# Paste it with the spaces removed (16 characters).
EMAIL_APP_PASSWORD=your16charapppassword

# The name people see in their inbox instead of the raw address.
# Optional - defaults to "Budget Buddy".
EMAIL_FROM_NAME=Budget Buddy

# The mail server to send through. Optional - defaults to Gmail.
# Only change these if you move to another provider, e.g. Brevo or SendGrid.
# Port 465 = SSL (default), port 587 = STARTTLS.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# Protects the /tasks/run-daily route that fires the scheduled reminders.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
TASK_TOKEN=replace-with-a-long-random-string

# Only needed when deploying. Locally this can be left out and the database
# lives in the instance folder. On a server use an ABSOLUTE path (4 slashes):
# DATABASE_URL=sqlite:////home/yourname/budget-buddy/instance/budget.db

# ---------------------------------------------------------------------------
# LOCAL TESTING ONLY - never put these in the server's .env
# ---------------------------------------------------------------------------
# The live database can't be reached from VS Code, so local runs need their own
# login. Set a password here and "python app.py" makes the account, or resets
# its password, on every start. Leave it out and nothing is created.
# DEV_ADMIN_PASSWORD=pick-anything-easy-to-type
# DEV_ADMIN_EMAIL=budgetbuddysite@gmail.com
# DEV_ADMIN_USER=Buddy
