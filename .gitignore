# Database - don't upload, it'll be empty/different on every PC
# (also covers backups like budget.db.bak2, which hold real personal data)
*.db
*.db.*
instance/

# Python auto-generated folders and files
__pycache__/
*.pyc

# Virtual environment folder (if you use one)
venv/
.venv/

# Environment variables / secrets
.env

# Editor / tool settings - personal to my machine, not part of the project
.claude/
.vscode/
